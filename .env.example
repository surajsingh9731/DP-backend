# Copy to .env and fill in real values. .env is gitignored — never commit it.

NODE_ENV=development
API_PORT=4300
WEB_ORIGIN=http://127.0.0.1:4200

# --- PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sahmati_local

# Privileged role used ONLY by the migration runner (schema owner / DDL rights).
# Typically your local Postgres superuser.
DB_ADMIN_USERNAME=postgres
DB_ADMIN_PASSWORD=change-me

# Restricted runtime role (NOSUPERUSER, NOBYPASSRLS) that the running app
# connects as. The migration runner creates this role for you — just pick
# a password here and the first `npm run db:migrate` provisions it.
DB_USERNAME=sahmati_app
DB_PASSWORD=change-me

# --- Auth ---
# Random, unique per environment. Mixed into every OTP/session-token hash.
AUTH_PEPPER=change-me

# --- Email (dev transport: itpo_admin Gmail/Workspace account) ---
# Gmail/Workspace requires an App Password (not your normal login password)
# since 2-step verification blocks plain SMTP auth.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=itpo_admin@example.com
SMTP_PASS=change-me
MAIL_FROM=itpo_admin@example.com

# --- WhatsApp Cloud API (not live until Meta Business verification + template approval land) ---
# Leave unset in dev — AppConfigService.whatsappEnabled is false and
# NotificationsService falls back to email automatically.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
