# Sahmati backend — local environment configuration.
# Copy to .env and fill in your own values. Never commit .env.

# --- Database ---------------------------------------------------------------
# Your local PostgreSQL connection. Create the database first with:
#   createdb -U postgres sahmati_local
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE=sahmati_local

# --- HTTP server --------------------------------------------------------------
API_PORT=4300
# Origin the frontend is served from (Angular dev server). Requests from any
# other Origin are rejected by the bootstrap origin check.
WEB_ORIGIN=http://127.0.0.1:4200

# --- Auth ---------------------------------------------------------------------
# Random local secret used to hash session tokens. Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_PEPPER=change-me-too

# --- Local mail sink ------------------------------------------------------------
# No real email is ever sent in local/dev mode. All outbound mail lands in the
# /api/dev/mail local mailbox instead (see MailboxComponent in the frontend).
MAIL_TRANSPORT=local-sink

# --- Worker ---------------------------------------------------------------------
# Poll interval (ms) for the delivery worker process (`npm run worker`).
WORKER_POLL_MS=1000
