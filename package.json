{
  "name": "@sahmati/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Sahmati NestJS backend: modular monolith over PostgreSQL/TypeORM. Local-sample implementation only — see docs/sources for scope boundaries.",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "worker": "node dist/worker/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\"",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:architecture": "vitest run tests/architecture",
    "local:init": "node scripts/local-init.mjs",
    "local:stop": "node scripts/local-stop.mjs",
    "db:migrate": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "db:migrate:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run test:unit && npm run test:architecture"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/typeorm": "12.0.2",
    "@sahmati/contracts": "file:./contracts",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.8",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@eslint/js": "10.0.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  }
}
