{
  "name": "@sahmati/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "local:init": "node scripts/database.mjs init",
    "local:stop": "node scripts/database.mjs stop",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/api/main.js",
    "worker": "node dist/src/worker/main.js",
    "lint": "eslint src tests --max-warnings 0",
    "test:unit": "npm run build && node --test dist/tests/unit/*.test.js && node --test scripts/source-architecture.spec.mjs",
    "test:integration": "node scripts/test-database.mjs && npm run build && SAHMATI_RUNTIME=.local/test-runtime.json node --test --test-concurrency=1 dist/tests/integration/*.test.js",
    "test": "npm run test:unit && npm run test:integration",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"contracts/*.{ts,json}\" \"scripts/*.{mjs,ts}\" \"*.json\" \"*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"contracts/*.{ts,json}\" \"scripts/*.{mjs,ts}\" \"*.json\" \"*.mjs\""
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/typeorm": "12.0.2",
    "@sahmati/contracts": "file:./contracts",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "fontkit": "2.0.4",
    "helmet": "8.3.0",
    "nodemailer": "10.1.2",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/fontkit": "2.0.9",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "eslint": "10.13.0",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
